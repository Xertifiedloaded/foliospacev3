
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SubscriptionTier {
  FREE
  PREMIUM
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  TRIAL
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model User {
  id               String             @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  email            String             @unique
  username         String             @unique
  password         String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  subscriptionTier SubscriptionTier   @default(FREE)
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  billingCycle     BillingCycle?      // MONTHLY or YEARLY (null for FREE)
  subscriptionStartDate DateTime?
  subscriptionEndDate DateTime?
  templatesLimit   Int                @default(3) 
  templatesUsed    Int                @default(0)
  
  // Relations
  cvs              CV[]
  blogPosts        BlogPost[]
  payments         Payment[]
  subscription     Subscription?
}

model Subscription {
  id                  String             @id @default(auto()) @map("_id") @db.ObjectId
  userId              String             @unique @db.ObjectId
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  tier                SubscriptionTier   @default(FREE)
  status              SubscriptionStatus @default(ACTIVE)
  billingCycle        BillingCycle?      // MONTHLY or YEARLY
  
  // Payment provider details (Paystack)
  paystackCustomerCode String?           @unique
  paystackSubscriptionCode String?      @unique
  paystackPlanCode    String?            // Paystack plan code (e.g., PLN_monthly, PLN_yearly)
  
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  cancelAtPeriodEnd   Boolean            @default(false)
  
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  
  @@index([userId, status])
}

model Payment {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  userId            String        @db.ObjectId
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  amount            Float
  currency          String        @default("USD")
  status            PaymentStatus @default(PENDING)
  
  // Payment provider details (Paystack)
  paystackReference   String?       @unique
  paystackAccessCode  String?
  paystackAuthorizationCode String?
  
  // What was purchased
  subscriptionTier  SubscriptionTier
  billingCycle      BillingCycle?      // MONTHLY or YEARLY
  description       String?
  
  // Metadata
  paymentMethod     String? // card, paypal, etc.
  receiptUrl        String?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  @@index([userId, status])
  @@index([createdAt])
}

model Template {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  previewUrl  String?
  category    String? // e.g., "professional", "creative", "minimal"
  tier        SubscriptionTier @default(FREE) // Which tier can access this template
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  cvs         CV[]
  
  @@index([tier, isActive])
}

model CV {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  templateId   String?  @db.ObjectId
  template     Template? @relation(fields: [templateId], references: [id])
  
  title        String
  personalInfo Json     @default("{}")
  educations   Json     @default("[]")
  experiences  Json     @default("[]")
  skills       Json     @default("[]")
  projects     Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([userId])
  @@index([templateId])
}

model BlogPost {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String // URL-friendly version of title (e.g., "my-first-post")
  content     String // Blog post content (markdown or HTML)
  excerpt     String? // Short description/summary
  coverImage  String? // Cover image URL
  tags        String[] // Array of tags
  isPublished Boolean   @default(false)
  publishedAt DateTime? // When the post was published
  readTime    Int? // Estimated read time in minutes
  views       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String        @db.ObjectId
  comments BlogComment[]
  likes    BlogLike[]
  
  @@unique([userId, slug])
  @@index([userId, isPublished, publishedAt])
  @@index([slug])
}

model BlogComment {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  author    String
  email     String
  website   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  post      BlogPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String        @db.ObjectId
  parentId  String?       @db.ObjectId
  parent    BlogComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   BlogComment[] @relation("CommentReplies")
  
  @@index([postId, createdAt])
}

model BlogLike {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  ipAddress String
  userAgent String?
  createdAt DateTime @default(now())
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String   @db.ObjectId
  @@unique([postId, ipAddress])
}